{
  "name": "nest-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @w/gateway run build",
    "deploy": "pnpm --filter @w/gateway run deploy",
    "format": "prettier --write \"{apps,packages,test}/**/*.ts\"",
    "start": "pnpm --filter @w/gateway run start",
    "start:dev": "pnpm --filter @w/gateway run start:dev",
    "start:debug": "pnpm --filter @w/gateway run start:debug",
    "start:prod": "NODE_ENV=production node dist/apps/gateway/src/main.js",
    "lint": "eslint \"{src,apps,packages,script,test}/**/*.ts\" --fix",
    "clean": "node ./script/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
